{"phrases":[{"id":"q_mao","zh":"小猫在哪儿？","py":"Xiǎo māo zài nǎr?","it":"Dov’è il gattino?"},{"id":"a_mao","zh":"小猫在那儿。","py":"Xiǎo māo zài nàr.","it":"Il gattino è lì."},{"id":"q_gou","zh":"小狗在哪儿？","py":"Xiǎo gǒu zài nǎr?","it":"Dov’è il cagnolino?"},{"id":"a_gou","zh":"小狗在椅子下面。","py":"Xiǎo gǒu zài yǐzi xiàmiàn.","it":"Il cagnolino è sotto la sedia."},{"id":"q_gongzuo","zh":"你在哪儿工作？","py":"Nǐ zài nǎr gōngzuò?","it":"Dove lavori?"},{"id":"a_xuexiao","zh":"我在学校工作。","py":"Wǒ zài xuéxiào gōngzuò.","it":"Lavoro in una scuola."},{"id":"q_erzi","zh":"你儿子在哪儿工作？","py":"Nǐ érzi zài nǎr gōngzuò?","it":"Dove lavora tuo figlio?"},{"id":"a_yiyuan","zh":"我儿子在医院工作，他是医生。","py":"Wǒ érzi zài yīyuàn gōngzuò, tā shì yīshēng.","it":"Mio figlio lavora in ospedale, è medico."},{"id":"q_jia","zh":"你爸爸在家吗？","py":"Nǐ bàba zài jiā ma?","it":"Tuo papà è a casa?"},{"id":"a_bu","zh":"不在家。","py":"Bú zài jiā.","it":"No, non c’è."},{"id":"q_ne","zh":"他在哪儿呢？","py":"Tā zài nǎr ne?","it":"E dov’è?"},{"id":"a_yiyuan2","zh":"他在医院。","py":"Tā zài yīyuàn.","it":"È in ospedale."},{"id":"n_beizi","zh":"我的杯子呢？","py":"Wǒ de bēizi ne?","it":"E la mia tazza? (dov’è?)"},{"id":"n_hecha","zh":"我在朋友家喝茶。","py":"Wǒ zài péngyou jiā hē chá.","it":"Bevo il tè a casa di un amico."}]}