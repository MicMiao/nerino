{"phrases":[{"id":"q_jia","zh":"你家有几口人？","py":"Nǐ jiā yǒu jǐ kǒu rén?","it":"Quante persone ci sono nella tua famiglia?"},{"id":"a_jia","zh":"我家有三口人。","py":"Wǒ jiā yǒu sān kǒu rén.","it":"Nella mia famiglia ci sono tre persone."},{"id":"q_nver","zh":"你女儿几岁了？","py":"Nǐ nǚ’ér jǐ suì le?","it":"Quanti anni ha tua figlia?"},{"id":"a_nver","zh":"她今年四岁了。","py":"Tā jīnnián sì suì le.","it":"Quest’anno ha quattro anni."},{"id":"q_li","zh":"李老师多大了？","py":"Lǐ lǎoshī duō dà le?","it":"Quanti anni ha la maestra Li?"},{"id":"a_li","zh":"她今年五十岁了。","py":"Tā jīnnián wǔshí suì le.","it":"Ha cinquant’anni."},{"id":"q_nver2","zh":"她女儿呢？","py":"Tā nǚ’ér ne?","it":"E sua figlia?"},{"id":"a_nver2","zh":"她女儿今年二十岁。","py":"Tā nǚ’ér jīnnián èrshí suì.","it":"Sua figlia ha vent’anni."},{"id":"q_ni","zh":"你今年多大了？","py":"Nǐ jīnnián duō dà le?","it":"Quanti anni hai quest’anno?"},{"id":"a_ni","zh":"我今年二十岁了。","py":"Wǒ jīnnián èrshí suì le.","it":"Ho vent’anni."}]}